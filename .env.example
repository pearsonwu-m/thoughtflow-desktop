# Development only. Copy to `.env` (which is git-ignored) and fill in.
#
# In the app, the Anthropic API key is entered in Settings → Claude and stored
# in the macOS Keychain. This variable is a fallback used only when no
# Keychain key exists, and only the Rust backend ever reads it.
ANTHROPIC_API_KEY=

# Optional: send API calls to a different base URL (a proxy, or a local mock
# server for testing). Defaults to https://api.anthropic.com.
# THOUGHTFLOW_API_BASE_URL=
